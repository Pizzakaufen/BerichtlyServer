# systemd-Unit für Berichtly Server 1.2 (Node.js).
# Installation: deploy/install.sh (siehe docs/DEPLOYMENT.md).
# Secrets stehen ausschließlich in der EnvironmentFile (Rechte 0640 root:berichtly), nie in dieser Datei.
# Node.js lauscht nur auf 127.0.0.1 (SERVER_HOST); öffentlich erreichbar ist allein Nginx.
[Unit]
Description=Berichtly Server (Backend für die Berichtly-Android-App)
Documentation=file:///opt/berichtly-server/README.md
After=network-online.target postgresql.service
Wants=network-online.target
# Wiederholte Abstürze nicht endlos neu starten (5 Versuche in 5 Minuten).
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=berichtly
Group=berichtly
WorkingDirectory=/opt/berichtly-server
EnvironmentFile=/etc/berichtly-server/berichtly-server.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/berichtly-server/src/cli.ts serve

# Kontrollierter Shutdown: SIGTERM -> keine neuen Anfragen (503), laufende Requests werden beendet,
# danach wird der Datenbank-Pool geschlossen (SHUTDOWN_TIMEOUT_SECONDS, Standard 15 s).
KillSignal=SIGTERM
TimeoutStopSec=30
TimeoutStartSec=120
Restart=on-failure
RestartSec=5

# Logs gehen nach journald (stdout/stderr); Rotation über journald (SystemMaxUse, siehe docs/OPERATIONS.md).
StandardOutput=journal
StandardError=journal
SyslogIdentifier=berichtly-server

# Härtung: kein root, keine zusätzlichen Rechte, nur lesender Zugriff auf das System.
# (MemoryDenyWriteExecute ist für Node.js nicht möglich: der JIT-Compiler benötigt ausführbaren Speicher.)
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
