# Berichtly Server 1.2 – Nginx für den PRODUKTIONSBETRIEB (HTTPS).
#
# Vorlage: ${BERICHTLY_DOMAIN} und ${BERICHTLY_UPSTREAM} werden beim Einrichten ersetzt
#   - Docker:  automatisch durch das offizielle nginx-Image (envsubst, siehe docker-compose.yml)
#   - Linux:   durch deploy/install-nginx.sh (envsubst, nur diese beiden Variablen)
# Nginx-Variablen wie $host bleiben dabei unverändert.
#
# Voraussetzung: Zertifikat unter /etc/letsencrypt/live/${BERICHTLY_DOMAIN}/ (siehe docs/HTTPS.md).
# Ohne Zertifikat startet Nginx mit dieser Vorlage bewusst nicht – es gibt keinen Rückfall auf HTTP.

include /etc/nginx/snippets/berichtly-http-context.conf;

upstream berichtly_upstream {
    server ${BERICHTLY_UPSTREAM};
    keepalive 32;
    keepalive_timeout 60s;   # kürzer als der Keep-Alive-Timeout von Node.js (75 s)
    keepalive_requests 1000;
}

# HTTP: nur Zertifikatsprüfung durch Let's Encrypt, alles andere dauerhaft auf HTTPS umleiten.
server {
    listen 80;
    #IPV6 listen [::]:80;
    server_name ${BERICHTLY_DOMAIN};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }
    location / {
        # 308 statt 301: Methode und Body bleiben erhalten. Die App muss trotzdem immer https:// verwenden –
        # über HTTP gesendete Tokens wären bereits ungeschützt übertragen.
        return 308 https://${BERICHTLY_DOMAIN}$request_uri;
    }
}

server {
    listen 443 ssl;
    #IPV6 listen [::]:443 ssl;
    # http2 on;   # ab nginx 1.25.1 möglich
    server_name ${BERICHTLY_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${BERICHTLY_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${BERICHTLY_DOMAIN}/privkey.pem;

    # Mozilla "intermediate": TLS 1.2 und 1.3, nur Cipher Suites mit Forward Secrecy.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:BerichtlyTLS:10m;
    ssl_session_tickets off;
    # OCSP Stapling entfällt: Let's Encrypt betreibt seit 2025 keine OCSP-Responder mehr.

    include /etc/nginx/snippets/berichtly-api.conf;
}
