# Berichtly Server 1.2.1 – Nginx für den Betrieb OHNE DOMAIN (HTTPS über die IP-Adresse).
#
# Vorlage: ${BERICHTLY_DOMAIN} ist hier die IPv4-Adresse des Servers, ${BERICHTLY_UPSTREAM} der Node.js-Server.
#   - Linux:   deploy/install-nginx.sh <ip> ip   (bzw. automatisch durch deploy/setup.sh)
#   - Docker:  NGINX_CONFIG=ip
#
# Verschlüsselt wie mit Domain (TLS 1.2/1.3), aber mit einem eigenen Zertifikat aus deploy/tls-selfsigned.sh.
# Browser zeigen dafür eine Warnung; die App vertraut dem Server über den Fingerabdruck des Schlüssels
# (Certificate Pinning, "berichtly-server tls-pin"). Ohne Zertifikat startet Nginx mit dieser Vorlage bewusst nicht.

include /etc/nginx/snippets/berichtly-http-context.conf;

upstream berichtly_upstream {
    server ${BERICHTLY_UPSTREAM};
    keepalive 32;
    keepalive_timeout 60s;   # kürzer als der Keep-Alive-Timeout von Node.js (75 s)
    keepalive_requests 1000;
}

# HTTP: dauerhaft auf HTTPS umleiten (308: Methode und Body bleiben erhalten). Die App muss trotzdem immer
# https:// verwenden – über HTTP gesendete Tokens wären bereits ungeschützt übertragen.
server {
    listen 80;
    #IPV6 listen [::]:80;
    server_name ${BERICHTLY_DOMAIN};

    location / {
        return 308 https://${BERICHTLY_DOMAIN}$request_uri;
    }
}

server {
    listen 443 ssl default_server;   # auch Anfragen mit anderer Host-Angabe (z. B. weitere IP) landen hier
    #IPV6 listen [::]:443 ssl;
    server_name ${BERICHTLY_DOMAIN};

    ssl_certificate     /etc/berichtly-server/tls/server.crt;
    ssl_certificate_key /etc/berichtly-server/tls/server.key;

    # Mozilla "intermediate": TLS 1.2 und 1.3, nur Cipher Suites mit Forward Secrecy.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:BerichtlyTLS:10m;
    ssl_session_tickets off;

    include /etc/nginx/snippets/berichtly-api.conf;
}
