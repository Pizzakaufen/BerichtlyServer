# =============================================================================
# Berichtly Server 1.2 – Beispielkonfiguration
# Kopieren nach .env (Docker Compose) bzw. /etc/berichtly-server/berichtly-server.env (systemd) und anpassen.
# Diese Datei enthält bewusst KEINE echten Secrets. Die Werte sind für den PRODUKTIONSBETRIEB voreingestellt;
# für die Entwicklung siehe docker-compose.dev.yml bzw. README ("Entwicklung").
# =============================================================================

# --- Umgebung -----------------------------------------------------------------------------------------
# development | test | production   (ohne Angabe: production)
APP_ENV=production

# --- Öffentlicher Zugang (Nginx) ------------------------------------------------------------------------
# Domain (ohne https://) oder – beim Betrieb ohne Domain – die IPv4-Adresse des Servers. Wird nur in die
# Nginx-Vorlage eingesetzt. deploy/setup.sh setzt den Wert automatisch.
BERICHTLY_DOMAIN=berichtly.example.de
# Nur Docker Compose: Nginx-Vorlage "https" (Domain, Standard), "ip" (ohne Domain, eigenes Zertifikat aus
# deploy/tls-selfsigned.sh) oder "http" (nur Entwicklung/Ersteinrichtung)
NGINX_CONFIG=https
# Nur Docker Compose mit NGINX_CONFIG=ip: Verzeichnis mit server.crt/server.key auf dem Host
TLS_DIR=/etc/berichtly-server/tls
# Nur Docker Compose: veröffentlichte Ports von Nginx (der einzige öffentlich erreichbare Dienst)
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
# Nur Docker Compose: Zertifikate (Certbot auf dem Host) und Webroot für die Let's-Encrypt-Prüfung
LETSENCRYPT_DIR=/etc/letsencrypt
CERTBOT_WEBROOT=./deploy/certbot/www
# Nur docker-compose.dev.yml: PostgreSQL zusätzlich auf 127.0.0.1:<Port> (nie in Produktion)
DB_DEV_PORT=5432

# --- Node.js-Server (nur intern, hinter Nginx) -----------------------------------------------------------
# 127.0.0.1 belassen: Node.js ist nie direkt öffentlich erreichbar. (Docker setzt intern 0.0.0.0 ohne Port-Freigabe.)
SERVER_HOST=127.0.0.1
SERVER_PORT=3000
# true, weil der Server ausschließlich über Nginx erreichbar ist (Client-IP aus X-Forwarded-For, HTTPS aus
# X-Forwarded-Proto). Auf false setzen, falls der Server ohne Proxy betrieben wird.
TRUST_PROXY=true
# Kontrollierter Shutdown: maximale Wartezeit auf laufende Requests (Sekunden)
SHUTDOWN_TIMEOUT_SECONDS=15
# Maximale Größe eines Request-Bodys in Byte (Standard 1 MiB; Nginx: client_max_body_size 1m)
MAX_REQUEST_BODY_BYTES=1048576

# --- Datenbank (PostgreSQL) -------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=berichtly
DB_USER=berichtly
# Pflicht. Starkes Passwort, z. B.:  openssl rand -base64 32
DB_PASSWORD=
# disable | allow | prefer | require | verify-ca | verify-full
# (allow/prefer verbinden ohne TLS; require verschlüsselt ohne Zertifikatsprüfung; verify-* prüft das Zertifikat)
DB_SSLMODE=prefer
# CA-Zertifikat für verify-ca/verify-full (Pfad, nicht im Repository ablegen)
# DB_SSL_CA_FILE=/etc/berichtly-server/db-ca.pem
# Alternativ vollständige URL (überschreibt DB_HOST/DB_PORT/DB_NAME/DB_SSLMODE; Benutzer/Passwort
# kommen weiterhin aus DB_USER/DB_PASSWORD):
# DB_URL=postgres://localhost:5432/berichtly?sslmode=require
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=0
DB_CONNECT_TIMEOUT_SECONDS=5
# Migrationen beim Start automatisch ausführen (alternativ: berichtly-server migrate)
DB_MIGRATE_ON_START=true

# --- Authentifizierung --------------------------------------------------------------------------------------
# Pflicht. Base64-kodierte Zufallsdaten (mind. 32 Byte):  openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=berichtly-server
JWT_AUDIENCE=berichtly-app
# Gültigkeit Access Token (1–60 Minuten) und Refresh Token (1–90 Tage)
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Maximale Lebensdauer einer Sitzung, auch bei regelmäßiger Erneuerung
SESSION_MAX_LIFETIME_DAYS=180
REGISTRATION_ENABLED=true
# Vorübergehende Kontosperre nach Fehlversuchen
LOGIN_MAX_FAILED_ATTEMPTS=10
LOGIN_LOCKOUT_MINUTES=15
# Zeitzone neuer Konten, wenn die App keine angibt
DEFAULT_TIMEZONE=Europe/Berlin

# --- Rate Limiting im Server (pro Minute; Nginx begrenzt zusätzlich grob, siehe deploy/nginx/) -------------
# Login pro Client-IP und zusätzlich pro Konto (E-Mail) – schützt auch vor verteilten Angriffen.
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_LOGIN_PER_ACCOUNT_PER_MINUTE=5
# Registrierung pro Client-IP
RATE_LIMIT_REGISTER_PER_MINUTE=5
# Token-Erneuerung pro Client-IP (normale App-Nutzung, daher großzügiger)
RATE_LIMIT_REFRESH_PER_MINUTE=30
# Alle übrigen Endpunkte pro Client-IP
RATE_LIMIT_API_PER_MINUTE=300
# Veraltet (1.0): Ist RATE_LIMIT_AUTH_PER_MINUTE gesetzt, gilt der Wert als Standard für
# Login, Registrierung und Token-Erneuerung (die drei Variablen oben haben Vorrang).
# RATE_LIMIT_AUTH_PER_MINUTE=10

# --- Aufbewahrung und Wartung (siehe docs/SYNC.md, "Aufbewahrung") ------------------------------------------
# Gelöschte Berichte (Tombstones) bleiben so lange erhalten, damit alle Geräte die Löschung erfahren.
# Geräte, die länger nicht synchronisiert haben, müssen vollständig neu synchronisieren.
TOMBSTONE_RETENTION_DAYS=365
# Idempotenz-Einträge verarbeiteter Sync-Operationen (Wiederholungen innerhalb dieser Zeit sind sicher)
SYNC_OPERATION_RETENTION_DAYS=30
# Technische Sicherheitsereignisse (Logins, Widerrufe – ohne Inhalte)
SECURITY_EVENT_RETENTION_DAYS=180
# Abgelaufene oder widerrufene Sitzungen
SESSION_RETENTION_DAYS=30
# Automatische Wartung im Server alle n Stunden (0 = aus; dann per Timer/Cron: berichtly-server maintenance)
MAINTENANCE_INTERVAL_HOURS=24

# --- CORS ------------------------------------------------------------------------------------------------------
# Die Android-App braucht kein CORS. Nur für spätere Web-Clients, kommagetrennt und mit Schema:
# CORS_ALLOWED_ORIGINS=https://app.example.de
CORS_ALLOWED_ORIGINS=

# --- Logging ----------------------------------------------------------------------------------------------------
# debug | info | warn | error ; text | json  (Standard: debug/text in Entwicklung, info/json in Produktion)
LOG_LEVEL=info
LOG_FORMAT=json

# --- API-Dokumentation (Swagger UI unter /api/docs, OpenAPI unter /api/openapi.yaml) ---------------------------
# In Produktion aus (sonst über Nginx öffentlich abrufbar).
API_DOCS_ENABLED=false

# --- Interner Statusbereich (/internal/status, über Nginx gesperrt) ----------------------------------------------
# Leer = deaktiviert. Sonst mind. 32 Zeichen:  openssl rand -hex 32
INTERNAL_STATUS_TOKEN=
# Unterhalb dieses freien Speicherplatzes meldet der Status "DEGRADED"
STATUS_MIN_FREE_DISK_MB=512
