# =============================================================================
# Berichtly Server 1.0 Alpha – Beispielkonfiguration
# Kopieren nach .env (Docker/Entwicklung) bzw. /etc/berichtly-server/berichtly-server.env (systemd)
# und anpassen. Diese Datei enthält bewusst KEINE echten Secrets.
# =============================================================================

# --- Umgebung -------------------------------------------------------------------
# development | test | production   (ohne Angabe: production)
APP_ENV=development

# --- HTTP-Server ----------------------------------------------------------------
# Ohne Docker 127.0.0.1 belassen und einen Reverse Proxy (HTTPS) davor setzen.
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
# Nur auf true setzen, wenn der Server AUSSCHLIESSLICH über einen Reverse Proxy erreichbar ist,
# der X-Forwarded-For setzt – sonst können Clients ihre IP für das Rate Limiting fälschen.
TRUST_PROXY=false
# Kontrollierter Shutdown: maximale Wartezeit auf laufende Requests (Sekunden)
SHUTDOWN_TIMEOUT_SECONDS=15
# Maximale Größe eines Request-Bodys in Byte (Standard 1 MiB)
MAX_REQUEST_BODY_BYTES=1048576

# --- Datenbank (PostgreSQL) ---------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=berichtly
DB_USER=berichtly
# Pflicht. Starkes Passwort, z. B.:  openssl rand -base64 32
DB_PASSWORD=
# disable | allow | prefer | require | verify-ca | verify-full
DB_SSLMODE=prefer
# Alternativ vollständige URL (überschreibt DB_HOST/DB_PORT/DB_NAME/DB_SSLMODE; Benutzer/Passwort
# kommen weiterhin aus DB_USER/DB_PASSWORD):
# DB_URL=postgres://localhost:5432/berichtly?sslmode=require
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=0
DB_CONNECT_TIMEOUT_SECONDS=5
# Migrationen beim Start automatisch ausführen (alternativ: berichtly-server migrate)
DB_MIGRATE_ON_START=true

# --- Authentifizierung ----------------------------------------------------------------
# Pflicht. Base64-kodierte Zufallsdaten (mind. 32 Byte):  openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=berichtly-server
JWT_AUDIENCE=berichtly-app
# Gültigkeit Access Token (1–60 Minuten) und Refresh Token (1–90 Tage)
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Maximale Lebensdauer einer Sitzung, auch bei regelmäßiger Erneuerung
SESSION_MAX_LIFETIME_DAYS=180
REGISTRATION_ENABLED=true
# Vorübergehende Kontosperre nach Fehlversuchen
LOGIN_MAX_FAILED_ATTEMPTS=10
LOGIN_LOCKOUT_MINUTES=15
# Zeitzone neuer Konten, wenn die App keine angibt
DEFAULT_TIMEZONE=Europe/Berlin

# --- Rate Limiting (pro Client-IP und Minute) ----------------------------------------------
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=300

# --- CORS ------------------------------------------------------------------------------------
# Die Android-App braucht kein CORS. Nur für spätere Web-Clients, kommagetrennt:
# CORS_ALLOWED_ORIGINS=https://app.example.de
CORS_ALLOWED_ORIGINS=

# --- Logging -----------------------------------------------------------------------------------
# debug | info | warn | error ; text | json  (Standard: debug/text in Entwicklung, info/json in Produktion)
LOG_LEVEL=debug
LOG_FORMAT=text

# --- API-Dokumentation (Swagger UI unter /api/docs) ------------------------------------------
API_DOCS_ENABLED=true

# --- Interner Statusbereich (/internal/status) --------------------------------------------------
# Leer = deaktiviert. Sonst mind. 32 Zeichen:  openssl rand -hex 32
INTERNAL_STATUS_TOKEN=
# Unterhalb dieses freien Speicherplatzes meldet der Status "DEGRADED"
STATUS_MIN_FREE_DISK_MB=512

# --- Nur Docker Compose -------------------------------------------------------------------------
# Port auf 127.0.0.1, unter dem der Server-Container veröffentlicht wird
SERVER_PUBLISHED_PORT=8080
